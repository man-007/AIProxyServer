# Copy this file to .env and keep all secrets there only.
# Do not commit the real .env file to source control.

PROXY_HOST=127.0.0.1
PROXY_PORT=8085
UPSTREAM_BASE_URL=https://integrate.api.nvidia.com
UPSTREAM_API_KEY=replace-with-your-real-key
UPSTREAM_MODELS_PATH=/v1/models
UPSTREAM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
UPSTREAM_CLIENT=httpx
MODEL_DISCOVERY_ENABLED=false
UPSTREAM_TIMEOUT_SECONDS=120
MODEL_CACHE_TTL_SECONDS=300
DEFAULT_MODEL=meta/llama-3.2-11b-vision-instruct
MODEL_ALIAS_HAIKU=
MODEL_ALIAS_SONNET=
MODEL_ALIAS_OPUS=
MODEL_ALIASES_JSON={}
PROXY_AUTH_ENABLED=false
PROXY_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=120
REDIS_URL=
TRUST_PROXY_HEADERS=false
LOG_LEVEL=info
